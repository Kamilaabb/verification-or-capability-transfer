{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v_record_v1.json",
  "title": "Authority v5 verifier record (pre-action, pre-grading)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "run_id", "source_g_run_id", "condition_id",
    "condition_hash", "replicate_id", "stage", "cell_id", "problem_id",
    "verifier", "call_seed", "raw_output", "reasoning_content", "v_report", "report_parse_status",
    "registered_request", "usage", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "v-record-v1"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "source_g_run_id": {"type": "string", "minLength": 1},
    "condition_id": {"type": "string", "minLength": 1},
    "condition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replicate_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "enum": ["dev30", "pilot300", "test"]},
    "cell_id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "verifier": {"$ref": "#/$defs/model_identity"},
    "call_seed": {"type": "integer", "minimum": 0},
    "raw_output": {"type": "string"},
    "reasoning_content": {"type": ["string", "null"]},
    "v_report": {
      "anyOf": [
        {"$ref": "v_report_payload_v1.json"},
        {"type": "null"}
      ]
    },
    "report_parse_status": {"type": "string", "enum": ["ok", "retry_ok", "fallback"]},
    "registered_request": {"type": "string", "enum": ["KEEP", "CRITIQUE_REVISE", "OVERRIDE"]},
    "usage": {"$ref": "#/$defs/usage"},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"report_parse_status": {"const": "fallback"}}, "required": ["report_parse_status"]},
      "then": {"properties": {"v_report": {"type": "null"}, "registered_request": {"const": "KEEP"}}}
    },
    {
      "if": {"properties": {"report_parse_status": {"enum": ["ok", "retry_ok"]}}, "required": ["report_parse_status"]},
      "then": {"properties": {"v_report": {"type": "object"}}}
    }
  ],
  "$defs": {
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "revision", "server_path", "backend", "prompt_sha256", "chat_template_sha256"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "server_path": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "chat_template_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "reasoning_tokens", "output_tokens", "latency_ms", "finish_reason", "retries"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "finish_reason": {"type": ["string", "null"]},
        "retries": {"type": "integer", "minimum": 0}
      }
    }
  }
}
