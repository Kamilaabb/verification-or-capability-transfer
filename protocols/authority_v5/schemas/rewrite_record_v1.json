{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rewrite_record_v1.json",
  "title": "Authority v5 critique-and-revise branch record (pre-grading)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "run_id", "source_v_run_id", "source_v_record_id",
    "condition_id", "condition_hash", "replicate_id", "stage", "cell_id", "problem_id",
    "registered_request", "rewrite_ran", "call_seed", "raw_output", "extracted_answer",
    "status", "failure_fallback_action", "usage", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "rewrite-record-v1"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "source_v_run_id": {"type": "string", "minLength": 1},
    "source_v_record_id": {"type": "string", "minLength": 1},
    "condition_id": {"type": "string", "minLength": 1},
    "condition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replicate_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "enum": ["dev30", "pilot300", "test"]},
    "cell_id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "registered_request": {"type": "string", "enum": ["KEEP", "CRITIQUE_REVISE", "OVERRIDE"]},
    "rewrite_ran": {"type": "boolean"},
    "call_seed": {"type": ["integer", "null"], "minimum": 0},
    "raw_output": {"type": ["string", "null"]},
    "extracted_answer": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["not_requested", "ok", "model_invalid", "call_error"]},
    "failure_fallback_action": {"type": ["string", "null"], "enum": ["KEEP", null]},
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "latency_ms", "finish_reason", "retries"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "finish_reason": {"type": ["string", "null"]},
        "retries": {"type": "integer", "minimum": 0}
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"registered_request": {"const": "KEEP"}}, "required": ["registered_request"]},
      "then": {"properties": {"status": {"const": "not_requested"}}}
    },
    {
      "if": {"properties": {"registered_request": {"enum": ["CRITIQUE_REVISE", "OVERRIDE"]}}, "required": ["registered_request"]},
      "then": {"properties": {"rewrite_ran": {"const": true}, "status": {"enum": ["ok", "model_invalid", "call_error"]}}}
    },
    {
      "if": {"properties": {"status": {"const": "not_requested"}}, "required": ["status"]},
      "then": {"properties": {"rewrite_ran": {"const": false}, "call_seed": {"type": "null"}, "raw_output": {"type": "null"}, "extracted_answer": {"type": "null"}, "failure_fallback_action": {"type": "null"}, "usage": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "ok"}}, "required": ["status"]},
      "then": {"properties": {"rewrite_ran": {"const": true}, "call_seed": {"type": "integer"}, "raw_output": {"type": "string"}, "extracted_answer": {"type": "string", "minLength": 1}, "failure_fallback_action": {"type": "null"}, "usage": {"type": "object"}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["model_invalid", "call_error"]}}, "required": ["status"]},
      "then": {"properties": {"rewrite_ran": {"const": true}, "extracted_answer": {"type": "null"}, "failure_fallback_action": {"const": "KEEP"}}}
    }
  ]
}
