{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g_record_single_v1.json",
  "title": "Authority v5 single-sample generator record (pre-grading)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "run_id", "condition_id", "condition_hash",
    "dataset_id", "replicate_id", "stage", "problem_id", "problem_text",
    "generator", "outputs", "y0_sample_index", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "g-record-single-v1"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "condition_id": {"type": "string", "minLength": 1},
    "condition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_id": {"type": "string", "minLength": 1},
    "replicate_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "enum": ["dev30", "pilot300", "test"]},
    "problem_id": {"type": "string", "minLength": 1},
    "problem_text": {"type": "string", "minLength": 1},
    "problem_metadata": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
    },
    "generator": {"$ref": "#/$defs/model_identity"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/output"}
    },
    "y0_sample_index": {"const": 0},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "revision", "server_path", "backend", "dtype", "quantization", "prompt_sha256", "chat_template_sha256"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "server_path": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "dtype": {"type": "string", "minLength": 1},
        "quantization": {"type": ["string", "null"]},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "chat_template_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_index", "call_seed", "raw_output", "extracted_answer", "parse_status", "usage"],
      "properties": {
        "sample_index": {"const": 0},
        "call_seed": {"type": "integer", "minimum": 0},
        "raw_output": {"type": "string"},
        "extracted_answer": {"type": ["string", "null"]},
        "parse_status": {"type": "string", "enum": ["ok", "model_invalid"]},
        "usage": {"$ref": "#/$defs/usage"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "latency_ms", "finish_reason", "retries"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "finish_reason": {"type": ["string", "null"]},
        "retries": {"type": "integer", "minimum": 0}
      }
    }
  }
}
