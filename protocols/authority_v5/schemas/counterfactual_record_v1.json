{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counterfactual_record_v1.json",
  "title": "Authority v5 post-grading counterfactual labels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "run_id", "source_g_run_id", "source_v_run_id",
    "source_rewrite_run_id", "source_evidence_record_id", "evidence_sha256", "condition_id",
    "condition_hash", "stage", "cell_id", "problem_id", "registered_request",
    "rewrite_status", "u0", "u1", "u2", "z0", "z1", "z2", "grader_status",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "counterfactual-record-v1"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "source_g_run_id": {"type": "string", "minLength": 1},
    "source_v_run_id": {"type": "string", "minLength": 1},
    "source_rewrite_run_id": {"type": ["string", "null"]},
    "source_evidence_record_id": {"type": "string", "minLength": 1},
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "condition_id": {"type": "string", "minLength": 1},
    "condition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stage": {"type": "string", "enum": ["dev30", "pilot300", "test"]},
    "cell_id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "registered_request": {"type": "string", "enum": ["KEEP", "CRITIQUE_REVISE", "OVERRIDE"]},
    "rewrite_status": {"type": "string", "enum": ["not_requested", "ok", "model_invalid", "call_error"]},
    "u0": {"$ref": "#/$defs/correctness"},
    "u1": {"$ref": "#/$defs/correctness"},
    "u2": {"$ref": "#/$defs/correctness"},
    "z0": {"$ref": "#/$defs/correctness"},
    "z1": {"$ref": "#/$defs/correctness"},
    "z2": {"$ref": "#/$defs/correctness"},
    "grader_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["y0", "y1", "y2"],
      "properties": {
        "y0": {"$ref": "#/$defs/grader_status"},
        "y1": {"$ref": "#/$defs/grader_status"},
        "y2": {"$ref": "#/$defs/grader_status"}
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"registered_request": {"const": "KEEP"}}, "required": ["registered_request"]},
      "then": {"properties": {"rewrite_status": {"const": "not_requested"}, "u1": {"type": "null"}}}
    },
    {
      "if": {"properties": {"rewrite_status": {"enum": ["model_invalid", "call_error"]}}, "required": ["rewrite_status"]},
      "then": {"properties": {"u1": {"type": "null"}}}
    }
  ],
  "$defs": {
    "correctness": {"type": ["integer", "null"], "enum": [0, 1, null]},
    "grader_status": {"type": "string", "enum": ["ok", "model_invalid", "grader_error", "not_run"]}
  }
}
