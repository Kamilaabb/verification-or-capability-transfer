{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g_record_single_v3.json",
  "title": "Authority v6 single-sample generator record with logprobs, portable identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "run_id",
    "condition_id",
    "condition_hash",
    "dataset_id",
    "replicate_id",
    "stage",
    "problem_id",
    "problem_text",
    "generator",
    "outputs",
    "y0_sample_index",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "g-record-single-v3"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "condition_id": {
      "type": "string",
      "minLength": 1
    },
    "condition_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "replicate_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_text": {
      "type": "string",
      "minLength": 1
    },
    "problem_metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "generator": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_index",
          "call_seed",
          "raw_output",
          "extracted_answer",
          "parse_status",
          "token_logprobs",
          "usage"
        ],
        "properties": {
          "sample_index": {
            "const": 0
          },
          "call_seed": {
            "type": "integer",
            "minimum": 0
          },
          "raw_output": {
            "type": "string"
          },
          "extracted_answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "parse_status": {
            "type": "string",
            "enum": [
              "ok",
              "model_invalid",
              "deferred_to_grader"
            ],
            "description": "deferred_to_grader is the code domain: whether a program can be recovered is decided by the sanitizer that will run it, in the grading sandbox. v2 omitted it while the runner already wrote it."
          },
          "token_logprobs": {
            "$ref": "generated_token_trace_v1.json"
          },
          "usage": {
            "$ref": "#/$defs/usage"
          }
        }
      }
    },
    "y0_sample_index": {
      "const": 0
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "latency_ms",
        "finish_reason",
        "retries"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "description": "Identity is not pinned. g_record_single_v2 fixes condition_id to c003, the dataset to math500 and the stage to pilot300, yet c005 and c006 both registered it unchanged for bigcodebench records at stage gate0. Nothing validates records against registered schemas, so it never surfaced. A record schema describes a record's shape; which condition produced it belongs in the record, not in the schema. Reused records keep the v2 schema they were written under."
}
