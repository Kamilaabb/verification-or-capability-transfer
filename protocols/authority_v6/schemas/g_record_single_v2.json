{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g_record_single_v2.json",
  "title": "Authority v6 single-sample generator record with logprobs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "run_id", "condition_id", "condition_hash", "dataset_id", "replicate_id", "stage", "problem_id", "problem_text", "generator", "outputs", "y0_sample_index", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "g-record-single-v2"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "condition_id": {"const": "c003"},
    "condition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_id": {"const": "math500-r6e4ed1-l3to5-dev300-s20260910"},
    "replicate_id": {"const": "g01"},
    "stage": {"const": "pilot300"},
    "problem_id": {"type": "string", "minLength": 1},
    "problem_text": {"type": "string", "minLength": 1},
    "problem_metadata": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}},
    "generator": {"type": "object"},
    "outputs": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sample_index", "call_seed", "raw_output", "extracted_answer", "parse_status", "token_logprobs", "usage"],
        "properties": {
          "sample_index": {"const": 0},
          "call_seed": {"type": "integer", "minimum": 0},
          "raw_output": {"type": "string"},
          "extracted_answer": {"type": ["string", "null"]},
          "parse_status": {"type": "string", "enum": ["ok", "model_invalid"]},
          "token_logprobs": {"$ref": "generated_token_trace_v1.json"},
          "usage": {"$ref": "#/$defs/usage"}
        }
      }
    },
    "y0_sample_index": {"const": 0},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "latency_ms", "finish_reason", "retries"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "finish_reason": {"type": ["string", "null"]},
        "retries": {"type": "integer", "minimum": 0}
      }
    }
  }
}
