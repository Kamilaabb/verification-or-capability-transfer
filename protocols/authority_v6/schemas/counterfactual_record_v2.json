{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "counterfactual_record_v2.json",
  "title": "Authority v6 post-grading counterfactual labels, portable identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "run_id",
    "source_g_run_id",
    "source_v_run_id",
    "source_rewrite_run_id",
    "source_evidence_record_id",
    "evidence_sha256",
    "condition_id",
    "condition_hash",
    "stage",
    "cell_id",
    "problem_id",
    "registered_request",
    "rewrite_status",
    "u0",
    "u1",
    "u2",
    "z0",
    "z1",
    "z2",
    "grader_status",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "counterfactual-record-v2"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_g_run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_v_run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_rewrite_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_evidence_record_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Null when the condition ran no controller evidence stage."
    },
    "evidence_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$",
      "description": "Null when the condition ran no controller evidence stage."
    },
    "condition_id": {
      "type": "string",
      "minLength": 1
    },
    "condition_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "cell_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "registered_request": {
      "type": "string",
      "enum": [
        "KEEP",
        "CRITIQUE_REVISE",
        "OVERRIDE"
      ]
    },
    "rewrite_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "ok",
        "model_invalid",
        "call_error"
      ],
      "description": "The grade stage's resolution of rewrite_record_v2's deferred_to_grader: ok when the rewritten program was usable, model_invalid when it was not. not_requested and call_error carry over unchanged from the rewrite record."
    },
    "u0": {
      "$ref": "#/$defs/correctness"
    },
    "u1": {
      "$ref": "#/$defs/correctness"
    },
    "u2": {
      "$ref": "#/$defs/correctness"
    },
    "z0": {
      "$ref": "#/$defs/correctness"
    },
    "z1": {
      "$ref": "#/$defs/correctness"
    },
    "z2": {
      "$ref": "#/$defs/correctness"
    },
    "grader_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "y0",
        "y1",
        "y2"
      ],
      "properties": {
        "y0": {
          "$ref": "#/$defs/grader_status"
        },
        "y1": {
          "$ref": "#/$defs/grader_status"
        },
        "y2": {
          "$ref": "#/$defs/grader_status"
        }
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "registered_request": {
            "const": "KEEP"
          }
        },
        "required": [
          "registered_request"
        ]
      },
      "then": {
        "properties": {
          "rewrite_status": {
            "const": "not_requested"
          },
          "u1": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rewrite_status": {
            "enum": [
              "model_invalid",
              "call_error"
            ]
          }
        },
        "required": [
          "rewrite_status"
        ]
      },
      "then": {
        "properties": {
          "u1": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_evidence_record_id": {
            "type": "null"
          }
        },
        "required": [
          "source_evidence_record_id"
        ]
      },
      "then": {
        "properties": {
          "evidence_sha256": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "correctness": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        0,
        1,
        null
      ]
    },
    "grader_status": {
      "type": "string",
      "enum": [
        "ok",
        "model_invalid",
        "grader_error",
        "not_run"
      ]
    }
  },
  "description": "v1 with stage unpinned. v1 enumerates stage as dev30, pilot300 or test, which no code-domain stage matches; c005 and c006 never hit it because Gate 0 ran no rewrite and so wrote no counterfactual records, and c007 at stage gate1 is the first run that would. rewrite_status keeps v1's vocabulary on purpose: rewrite_record_v2 reports deferred_to_grader because extraction has not happened yet, and this record is written after grading, which is exactly where that resolves into ok or model_invalid. The two evidence fields are also nullable here. v1 required them because every prior condition ran a controller evidence stage before grading; Gate 1 registers no feature contract and runs none, so there is no evidence record to point at. Filling them with some other hash to satisfy the schema would be worse than saying there was none."
}
