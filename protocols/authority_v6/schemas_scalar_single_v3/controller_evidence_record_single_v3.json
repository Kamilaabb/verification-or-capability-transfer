{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controller_evidence_record_single_v3.json",
  "title": "Authority v6 scalar_single_v3 controller evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "run_id", "source_g_run_id", "source_v_run_id",
    "condition_id", "condition_hash", "replicate_id", "stage", "cell_id", "problem_id",
    "feature_set_id", "feature_contract_sha256", "features", "missingness",
    "evidence_sha256", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "controller-evidence-record-single-v3"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "source_g_run_id": {"type": "string", "minLength": 1},
    "source_v_run_id": {"type": "string", "minLength": 1},
    "condition_id": {"const": "c004"},
    "condition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replicate_id": {"const": "v01"},
    "stage": {"const": "pilot300"},
    "cell_id": {"const": "V-A"},
    "problem_id": {"type": "string", "minLength": 1},
    "feature_set_id": {"const": "scalar_single_v3"},
    "feature_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "features": {"$ref": "#/$defs/features"},
    "missingness": {"$ref": "#/$defs/missingness"},
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "binary": {"type": "integer", "enum": [0, 1]},
    "nullable_binary": {"type": ["integer", "null"], "enum": [0, 1, null]},
    "nullable_boolean": {"type": ["boolean", "null"]},
    "nullable_logprob": {"type": ["number", "null"], "maximum": 0},
    "nullable_nonnegative": {"type": ["number", "null"], "minimum": 0},
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "g_answer_extractable", "v_verdict_correct", "v_verdict_incorrect", "v_verdict_uncertain",
        "v_request_keep", "v_request_revise", "v_request_override", "v_candidate_extractable",
        "gv_final_answer_equivalent", "g_output_mean_logprob", "g_final_answer_mean_logprob",
        "v_verdict_mean_logprob", "v_request_mean_logprob", "v_candidate_answer_mean_logprob",
        "v_critique_token_length_log", "gv_answer_type_match"
      ],
      "properties": {
        "g_answer_extractable": {"$ref": "#/$defs/binary"},
        "v_verdict_correct": {"$ref": "#/$defs/nullable_binary"},
        "v_verdict_incorrect": {"$ref": "#/$defs/nullable_binary"},
        "v_verdict_uncertain": {"$ref": "#/$defs/nullable_binary"},
        "v_request_keep": {"$ref": "#/$defs/binary"},
        "v_request_revise": {"$ref": "#/$defs/binary"},
        "v_request_override": {"$ref": "#/$defs/binary"},
        "v_candidate_extractable": {"$ref": "#/$defs/nullable_binary"},
        "gv_final_answer_equivalent": {"$ref": "#/$defs/nullable_boolean"},
        "g_output_mean_logprob": {"$ref": "#/$defs/nullable_logprob"},
        "g_final_answer_mean_logprob": {"$ref": "#/$defs/nullable_logprob"},
        "v_verdict_mean_logprob": {"$ref": "#/$defs/nullable_logprob"},
        "v_request_mean_logprob": {"$ref": "#/$defs/nullable_logprob"},
        "v_candidate_answer_mean_logprob": {"$ref": "#/$defs/nullable_logprob"},
        "v_critique_token_length_log": {"$ref": "#/$defs/nullable_nonnegative"},
        "gv_answer_type_match": {"$ref": "#/$defs/nullable_boolean"}
      }
    },
    "missingness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "g_answer_extractable", "v_verdict_correct", "v_verdict_incorrect", "v_verdict_uncertain",
        "v_request_keep", "v_request_revise", "v_request_override", "v_candidate_extractable",
        "gv_final_answer_equivalent", "g_output_mean_logprob", "g_final_answer_mean_logprob",
        "v_verdict_mean_logprob", "v_request_mean_logprob", "v_candidate_answer_mean_logprob",
        "v_critique_token_length_log", "gv_answer_type_match"
      ],
      "properties": {
        "g_answer_extractable": {"type": "boolean"},
        "v_verdict_correct": {"type": "boolean"},
        "v_verdict_incorrect": {"type": "boolean"},
        "v_verdict_uncertain": {"type": "boolean"},
        "v_request_keep": {"type": "boolean"},
        "v_request_revise": {"type": "boolean"},
        "v_request_override": {"type": "boolean"},
        "v_candidate_extractable": {"type": "boolean"},
        "gv_final_answer_equivalent": {"type": "boolean"},
        "g_output_mean_logprob": {"type": "boolean"},
        "g_final_answer_mean_logprob": {"type": "boolean"},
        "v_verdict_mean_logprob": {"type": "boolean"},
        "v_request_mean_logprob": {"type": "boolean"},
        "v_candidate_answer_mean_logprob": {"type": "boolean"},
        "v_critique_token_length_log": {"type": "boolean"},
        "gv_answer_type_match": {"type": "boolean"}
      }
    }
  }
}
