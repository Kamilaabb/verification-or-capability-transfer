{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "code_review_evidence_record_v1.json",
  "title": "BigCodeBench scalar evidence (code_solve_scalar_v1), written before grading",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "run_id",
    "source_record_run_id",
    "source_logit_run_id",
    "condition_id",
    "condition_hash",
    "problem_id",
    "role",
    "feature_contract",
    "features",
    "missingness",
    "audit",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "code-evidence-record-v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_record_run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_logit_run_id": {
      "type": "string",
      "minLength": 1
    },
    "condition_id": {
      "type": "string",
      "enum": [
        "c110",
        "c111"
      ]
    },
    "condition_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "review"
      ]
    },
    "feature_contract": {
      "const": "code_solve_scalar_v1"
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_char_count",
        "prompt_tokens",
        "output_token_count",
        "truncated",
        "python_block_count",
        "out_lp_mean",
        "out_lp_min",
        "out_lp_p10",
        "out_lp_std",
        "out_ent_mean",
        "out_ent_p90",
        "out_ent_max",
        "out_margin_mean",
        "out_margin_p10",
        "out_max_logit_mean",
        "out_lowconf_frac",
        "out_lowconf_run"
      ],
      "properties": {
        "problem_char_count": {
          "type": [
            "number",
            "null"
          ]
        },
        "prompt_tokens": {
          "type": [
            "number",
            "null"
          ]
        },
        "output_token_count": {
          "type": [
            "number",
            "null"
          ]
        },
        "truncated": {
          "type": [
            "number",
            "null"
          ]
        },
        "python_block_count": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_lp_mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_lp_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_lp_p10": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_lp_std": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_ent_mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_ent_p90": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_ent_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_margin_mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_margin_p10": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_max_logit_mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_lowconf_frac": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_lowconf_run": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "missingness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_char_count",
        "prompt_tokens",
        "output_token_count",
        "truncated",
        "python_block_count",
        "out_lp_mean",
        "out_lp_min",
        "out_lp_p10",
        "out_lp_std",
        "out_ent_mean",
        "out_ent_p90",
        "out_ent_max",
        "out_margin_mean",
        "out_margin_p10",
        "out_max_logit_mean",
        "out_lowconf_frac",
        "out_lowconf_run"
      ],
      "properties": {
        "problem_char_count": {
          "type": "boolean"
        },
        "prompt_tokens": {
          "type": "boolean"
        },
        "output_token_count": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "python_block_count": {
          "type": "boolean"
        },
        "out_lp_mean": {
          "type": "boolean"
        },
        "out_lp_min": {
          "type": "boolean"
        },
        "out_lp_p10": {
          "type": "boolean"
        },
        "out_lp_std": {
          "type": "boolean"
        },
        "out_ent_mean": {
          "type": "boolean"
        },
        "out_ent_p90": {
          "type": "boolean"
        },
        "out_ent_max": {
          "type": "boolean"
        },
        "out_margin_mean": {
          "type": "boolean"
        },
        "out_margin_p10": {
          "type": "boolean"
        },
        "out_max_logit_mean": {
          "type": "boolean"
        },
        "out_lowconf_frac": {
          "type": "boolean"
        },
        "out_lowconf_run": {
          "type": "boolean"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_token_count",
        "paired_token_count"
      ],
      "properties": {
        "content_token_count": {
          "type": "integer",
          "minimum": 0
        },
        "paired_token_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "code_evidence_record_v1 for the review conditions c110-c111: the same code_solve_scalar_v1 features of the reviewer's own output. A separate file so the solo schema never changes while c100-c109 run."
}
