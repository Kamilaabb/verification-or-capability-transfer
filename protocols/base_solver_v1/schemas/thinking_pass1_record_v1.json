{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thinking_pass1_record_v1.json",
  "title": "Thinking-on single-pass base solver record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "run_id", "condition_id",
    "condition_hash", "dataset_id", "replicate_id", "stage", "problem_id",
    "problem_text", "generator", "output", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "thinking-pass1-record-v1"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "condition_id": {"type": "string", "minLength": 1},
    "condition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_id": {"type": "string", "minLength": 1},
    "replicate_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "problem_text": {"type": "string", "minLength": 1},
    "generator": {"type": "object"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_index", "call_seed", "raw_reasoning", "raw_output",
        "extracted_answer", "parse_status", "usage"],
      "properties": {
        "sample_index": {"const": 0},
        "call_seed": {"const": 42},
        "raw_reasoning": {"type": ["string", "null"]},
        "raw_output": {"type": "string"},
        "extracted_answer": {"type": ["string", "null"]},
        "parse_status": {
          "type": "string",
          "enum": ["ok", "model_invalid", "call_error"]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "reasoning_tokens",
            "latency_ms", "finish_reason", "retries"],
          "properties": {
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
            "latency_ms": {"type": ["number", "null"], "minimum": 0},
            "finish_reason": {"type": ["string", "null"]},
            "retries": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "description": "The reasoning channel and final content are preserved separately. A length finish does not determine correctness; extracted answers from truncated content are still graded."
}
