{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math_verifier_scalar_evidence_record_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "run_id", "source_g_run_id",
    "source_g_logit_run_id", "source_v_run_id", "source_v_logit_run_id",
    "condition_id", "condition_hash", "problem_id", "parser_id", "features",
    "missingness", "v_math_spans", "v_math_token_indices", "v_field_token_indices",
    "location_match_status", "g_error_location_char_span", "g_error_location_token_indices",
    "created_at_utc"],
  "properties": {
    "schema_version": {"const": "math-verifier-scalar-evidence-record-v1"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "source_g_run_id": {"type": "string", "minLength": 1},
    "source_g_logit_run_id": {"type": "string", "minLength": 1},
    "source_v_run_id": {"type": "string", "minLength": 1},
    "source_v_logit_run_id": {"type": "string", "minLength": 1},
    "condition_id": {"const": "c018"},
    "condition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "problem_id": {"type": "string", "minLength": 1},
    "parser_id": {"const": "math_expression_spans_v1"},
    "features": {"$ref": "#/$defs/features"},
    "missingness": {"$ref": "#/$defs/missingness"},
    "v_math_spans": {"type": "array", "items": {"$ref": "#/$defs/math_span"}},
    "v_math_token_indices": {"$ref": "#/$defs/token_indices"},
    "v_field_token_indices": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "verdict": {"$ref": "#/$defs/token_indices"},
        "action": {"$ref": "#/$defs/token_indices"},
        "error_location": {"$ref": "#/$defs/token_indices"},
        "critique": {"$ref": "#/$defs/token_indices"},
        "corrected_content": {"$ref": "#/$defs/token_indices"},
        "final_answer": {"$ref": "#/$defs/token_indices"}
      }
    },
    "location_match_status": {"type": "string", "enum": ["not_given", "exact", "whitespace_match", "not_found", "ambiguous", "report_fallback"]},
    "g_error_location_char_span": {"anyOf": [{"$ref": "#/$defs/span"}, {"type": "null"}]},
    "g_error_location_token_indices": {"$ref": "#/$defs/token_indices"},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "number_or_null": {"type": ["number", "null"]},
    "binary_or_null": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["v_verdict_correct", "v_verdict_incorrect", "v_verdict_uncertain",
        "v_action_keep", "v_action_critique_refine", "v_candidate_answer_parseable",
        "gv_final_answer_equivalent", "v_verdict_correct_mean_logprob",
        "v_verdict_incorrect_mean_logprob", "v_verdict_uncertain_mean_logprob",
        "v_action_mean_logprob", "v_math_expression_mean_logprob",
        "v_critique_token_length_log", "v_verdict_correct_mean_max_logit",
        "v_verdict_incorrect_mean_max_logit", "v_verdict_uncertain_mean_max_logit",
        "v_action_mean_max_logit", "v_math_expression_mean_max_logit",
        "v_error_location_exact", "v_error_location_given",
        "v_error_location_whitespace_match", "v_error_location_not_found",
        "v_error_location_ambiguous", "v_error_location_mean_logprob",
        "v_error_location_mean_max_logit", "g_error_location_mean_logprob",
        "g_error_location_mean_max_logit", "v_output_mean_logprob",
        "v_output_mean_max_logit"],
      "properties": {
        "v_verdict_correct": {"$ref": "#/$defs/binary_or_null"},
        "v_verdict_incorrect": {"$ref": "#/$defs/binary_or_null"},
        "v_verdict_uncertain": {"$ref": "#/$defs/binary_or_null"},
        "v_action_keep": {"$ref": "#/$defs/binary_or_null"},
        "v_action_critique_refine": {"$ref": "#/$defs/binary_or_null"},
        "v_candidate_answer_parseable": {"$ref": "#/$defs/binary_or_null"},
        "gv_final_answer_equivalent": {"type": ["boolean", "null"]},
        "v_verdict_correct_mean_logprob": {"$ref": "#/$defs/number_or_null"},
        "v_verdict_incorrect_mean_logprob": {"$ref": "#/$defs/number_or_null"},
        "v_verdict_uncertain_mean_logprob": {"$ref": "#/$defs/number_or_null"},
        "v_action_mean_logprob": {"$ref": "#/$defs/number_or_null"},
        "v_math_expression_mean_logprob": {"$ref": "#/$defs/number_or_null"},
        "v_critique_token_length_log": {"$ref": "#/$defs/number_or_null"},
        "v_verdict_correct_mean_max_logit": {"$ref": "#/$defs/number_or_null"},
        "v_verdict_incorrect_mean_max_logit": {"$ref": "#/$defs/number_or_null"},
        "v_verdict_uncertain_mean_max_logit": {"$ref": "#/$defs/number_or_null"},
        "v_action_mean_max_logit": {"$ref": "#/$defs/number_or_null"},
        "v_math_expression_mean_max_logit": {"$ref": "#/$defs/number_or_null"},
        "v_error_location_exact": {"$ref": "#/$defs/binary_or_null"},
        "v_error_location_given": {"$ref": "#/$defs/binary_or_null"},
        "v_error_location_whitespace_match": {"$ref": "#/$defs/binary_or_null"},
        "v_error_location_not_found": {"$ref": "#/$defs/binary_or_null"},
        "v_error_location_ambiguous": {"$ref": "#/$defs/binary_or_null"},
        "v_error_location_mean_logprob": {"$ref": "#/$defs/number_or_null"},
        "v_error_location_mean_max_logit": {"$ref": "#/$defs/number_or_null"},
        "g_error_location_mean_logprob": {"$ref": "#/$defs/number_or_null"},
        "g_error_location_mean_max_logit": {"$ref": "#/$defs/number_or_null"},
        "v_output_mean_logprob": {"$ref": "#/$defs/number_or_null"},
        "v_output_mean_max_logit": {"$ref": "#/$defs/number_or_null"}
      }
    },
    "missingness": {
      "type": "object", "additionalProperties": false,
      "required": ["v_verdict_correct", "v_verdict_incorrect", "v_verdict_uncertain",
        "v_action_keep", "v_action_critique_refine", "v_candidate_answer_parseable",
        "gv_final_answer_equivalent", "v_verdict_correct_mean_logprob",
        "v_verdict_incorrect_mean_logprob", "v_verdict_uncertain_mean_logprob",
        "v_action_mean_logprob", "v_math_expression_mean_logprob",
        "v_critique_token_length_log", "v_verdict_correct_mean_max_logit",
        "v_verdict_incorrect_mean_max_logit", "v_verdict_uncertain_mean_max_logit",
        "v_action_mean_max_logit", "v_math_expression_mean_max_logit",
        "v_error_location_exact", "v_error_location_given",
        "v_error_location_whitespace_match", "v_error_location_not_found",
        "v_error_location_ambiguous", "v_error_location_mean_logprob",
        "v_error_location_mean_max_logit", "g_error_location_mean_logprob",
        "g_error_location_mean_max_logit", "v_output_mean_logprob",
        "v_output_mean_max_logit"],
      "properties": {
        "v_verdict_correct": {"type": "boolean"}, "v_verdict_incorrect": {"type": "boolean"},
        "v_verdict_uncertain": {"type": "boolean"}, "v_action_keep": {"type": "boolean"},
        "v_action_critique_refine": {"type": "boolean"}, "v_candidate_answer_parseable": {"type": "boolean"},
        "gv_final_answer_equivalent": {"type": "boolean"}, "v_verdict_correct_mean_logprob": {"type": "boolean"},
        "v_verdict_incorrect_mean_logprob": {"type": "boolean"}, "v_verdict_uncertain_mean_logprob": {"type": "boolean"},
        "v_action_mean_logprob": {"type": "boolean"}, "v_math_expression_mean_logprob": {"type": "boolean"},
        "v_critique_token_length_log": {"type": "boolean"}, "v_verdict_correct_mean_max_logit": {"type": "boolean"},
        "v_verdict_incorrect_mean_max_logit": {"type": "boolean"}, "v_verdict_uncertain_mean_max_logit": {"type": "boolean"},
        "v_action_mean_max_logit": {"type": "boolean"}, "v_math_expression_mean_max_logit": {"type": "boolean"},
        "v_error_location_exact": {"type": "boolean"},
        "v_error_location_given": {"type": "boolean"}, "v_error_location_whitespace_match": {"type": "boolean"},
        "v_error_location_not_found": {"type": "boolean"}, "v_error_location_ambiguous": {"type": "boolean"},
        "v_error_location_mean_logprob": {"type": "boolean"},
        "v_error_location_mean_max_logit": {"type": "boolean"}, "g_error_location_mean_logprob": {"type": "boolean"},
        "g_error_location_mean_max_logit": {"type": "boolean"}, "v_output_mean_logprob": {"type": "boolean"},
        "v_output_mean_max_logit": {"type": "boolean"}
      }
    },
    "span": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
    "token_indices": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "math_span": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end", "kind"],
      "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "kind": {"type": "string"}}
    }
  }
}
